{
  "name": "agent-office",
  "version": "0.0.0",
  "private": true,
  "description": "A 3D virtual office that shows, live, what your AI coding agents are doing.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude ./client/** server/index.ts --dev",
    "demo": "tsx watch --clear-screen=false --exclude ./client/** server/index.ts --dev --demo",
    "dev:client": "vite --config vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "hooks:install": "tsx scripts/hooks-install.ts install",
    "hooks:uninstall": "tsx scripts/hooks-install.ts uninstall",
    "hooks:status": "tsx scripts/hooks-install.ts status",
    "shot": "node scripts/shot.mjs",
    "assets:fetch": "tsx scripts/assets/fetch.ts",
    "assets:build": "tsx scripts/assets/build.ts",
    "usage:install": "tsx scripts/usage-install.ts install",
    "usage:uninstall": "tsx scripts/usage-install.ts uninstall",
    "usage:status": "tsx scripts/usage-install.ts status",
    "theme:check": "tsx scripts/themes/check.ts",
    "theme:new": "tsx scripts/themes/new.ts",
    "soak": "node --expose-gc --import tsx scripts/soak.ts",
    "docker:up": "tsx scripts/docker-up.ts",
    "docker:down": "tsx scripts/docker-up.ts down",
    "release": "tsx scripts/release.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.64.1",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
